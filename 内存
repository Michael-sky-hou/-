#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct AllocBlock {
    char id[16];
    long long start;
    long long size;
    struct AllocBlock *next;
} AllocBlock;

typedef struct FreeBlock {
    long long start;
    long long size;
    struct FreeBlock *next;
} FreeBlock;

/*  全局状态  */

static long long    g_total = 0;
static AllocBlock  *g_alloc = NULL;  /* 已分配块链表，按起始地址升序 */
static FreeBlock   *g_free  = NULL;  /* 空闲块链表，按起始地址升序    */

/工具函数 /

static void cleanup(void) {
    AllocBlock *ab, *an;
    FreeBlock  *fb, *fn;
    for (ab = g_alloc; ab; ab = an) { an = ab->next; free(ab); }
    for (fb = g_free;  fb; fb = fn) { fn = fb->next; free(fb); }
    g_alloc = NULL;
    g_free  = NULL;
}

/*  已分配链表操作 */

static AllocBlock *find_alloc(const char *id) {
    AllocBlock *p;
    for (p = g_alloc; p; p = p->next)
        if (strcmp(p->id, id) == 0) return p;
    return NULL;
}
static void insert_alloc_sorted(AllocBlock *node) {
    AllocBlock *p;
    if (!g_alloc || g_alloc->start >= node->start) {
        node->next = g_alloc;
        g_alloc = node;
        return;
    }
    p = g_alloc;
    while (p->next && p->next->start < node->start) p = p->next;
    node->next = p->next;
    p->next = node;
}

static AllocBlock *remove_alloc(const char *id) {
    AllocBlock **pp;
    AllocBlock *t;
    pp = &g_alloc;
    while (*pp) {
        if (strcmp((*pp)->id, id) == 0) {
            t = *pp;
            *pp = t->next;
            t->next = NULL;
            return t;
        }
        pp = &(*pp)->next;
    }
    return NULL;
}

/ 空闲链表操作 /

static void insert_free_sorted(FreeBlock *node) {
    FreeBlock *p;
    if (!g_free || g_free->start >= node->start) {
        node->next = g_free;
        g_free = node;
        return;
    }
    p = g_free;
    while (p->next && p->next->start < node->start) p = p->next;
    node->next = p->next;
    p->next = node;
}

static void merge_free(void) {
    FreeBlock *p;
    FreeBlock *q;
    p = g_free;
    while (p && p->next) {
        if (p->start + p->size == p->next->start) {
            q = p->next;
            p->size += q->size;
            p->next = q->next;
            free(q);
        } else {
            p = p->next;
        }
    }
}

/找到能容纳size、尺寸最小，同尺寸取起始地址更小的空闲块
   找到的前驱节点存入 prev_out /
static FreeBlock *best_fit(long long size, FreeBlock **prev_out) {
    FreeBlock *best, *best_prev;
    FreeBlock *p, *prev;
    best = NULL; best_prev = NULL;
    p = g_free; prev = NULL;
    while (p) {
        if (p->size >= size) {
            if (!best ||
                p->size < best->size ||
                (p->size == best->size && p->start < best->start)) {
                best = p;
                best_prev = prev;
            }
        }
        prev = p;
        p = p->next;
    }
    if (prev_out) *prev_out = best_prev;
    return best;
}
/ALLOC 申请内存指令/

static void cmd_alloc(const char *id, long long size) {
    FreeBlock *prev;
    FreeBlock *fb;
    AllocBlock *ab;
    long long start;
    if (find_alloc(id)) {
        printf("ALLOC_FAILED %s DUPLICATE\n", id);
        return;
    }
    fb = best_fit(size, &prev);
    if (!fb) {
        printf("ALLOC_FAILED %s NO_SPACE\n", id);
        return;
    }
    start = fb->start;
    if (fb->size == size) {
        /* 整块分配，直接删除该空闲块 */
        if (prev) prev->next = fb->next;
        else      g_free = fb->next;
        free(fb);
    } else {
        /* 从低地址分割，剩余部分保留为空闲块 */
        fb->start += size;
        fb->size  -= size;
    }
    ab = (AllocBlock *)malloc(sizeof(AllocBlock));
    strcpy(ab->id, id);
    ab->start = start;
    ab->size  = size;
    ab->next  = NULL;
    insert_alloc_sorted(ab);
    printf("ALLOCATED %s %lld\n", id, start);
}

/FREE 释放内存指令/

static void cmd_free(const char *id) {
    AllocBlock *ab;
    FreeBlock  *fb;
    long long start, size;
    ab = remove_alloc(id);
    if (!ab) {
        printf("FREE_FAILED %s NOT_FOUND\n", id);
        return;
    }
    start = ab->start;
    size  = ab->size;
    free(ab);
    fb = (FreeBlock *)malloc(sizeof(FreeBlock));
    fb->start = start;
    fb->size  = size;
    fb->next  = NULL;
    insert_free_sorted(fb);
    merge_free();
    printf("FREED %s %lld %lld\n", id, start, size);
}

/ QUERY 查询内存指令 /

static void cmd_query(const char *id) {
    AllocBlock *ab;
    ab = find_alloc(id);
    if (!ab) {
        printf("BLOCK_NOT_FOUND %s\n", id);
        return;
    }
    printf("BLOCK %s %lld %lld\n", id, ab->start, ab->size);
}

/DUMP 打印内存状态指令 /

static void cmd_dump(void) {
    int k, t;
    AllocBlock *pa;
    FreeBlock  *pf;
    k = 0; t = 0;
    for (pa = g_alloc; pa; pa = pa->next) k++;
    for (pf = g_free;  pf; pf = pf->next) t++;
    printf("ALLOCATED_BLOCKS %d\n", k);
    for (pa = g_alloc; pa; pa = pa->next)
        printf("%s %lld %lld\n", pa->id, pa->start, pa->size);
    printf("FREE_BLOCKS %d\n", t);
    for (pf = g_free; pf; pf = pf->next)
        printf("%lld %lld\n", pf->start, pf->size);
}

